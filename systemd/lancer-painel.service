[Unit]
Description=Painel TFT Lancer HL 2016
After=network-online.target bluetooth.service gpsd.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__ROOT__
Environment=LANCER_SOURCE=obd
Environment=LANCER_OBD_PORT=/dev/rfcomm0
Environment=LANCER_ALLOW_SHUTDOWN=1
Environment=PYTHONUNBUFFERED=1
ExecStart=__ROOT__/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

# Evita que um kill brusco corrompa o SQLite / cartão:
TimeoutStopSec=15
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
